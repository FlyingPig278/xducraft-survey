# Local development API server
PORT=8787
FRONTEND_BASE_URL=http://localhost:5173
XDUCRAFT_DATA_DIR=./data
XDUCRAFT_LOG_DIR=./data/logs
XDUCRAFT_ACCESS_LOG_FILE=./data/logs/access.log
XDUCRAFT_ACCESS_FILE_LOG=true
XDUCRAFT_AUTH_LOG_FILE=./data/logs/auth.log
XDUCRAFT_AUTH_FILE_LOG=true
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_SECONDS=1209600
XDUCRAFT_PROXY_SECRET=

# XDUCraft skin site OAuth2 adapter
BLESSING_BASE_URL=https://skin.example.com
BLESSING_CLIENT_ID=
BLESSING_CLIENT_SECRET=
BLESSING_REDIRECT_URI=http://localhost:8787/api/auth/blessing/callback
BLESSING_OAUTH_SCOPE=User.Read Player.Read
BLESSING_DNS_RESULT_ORDER=ipv4first
BLESSING_IP_FAMILY=4
BLESSING_FETCH_TIMEOUT_MS=8000
BLESSING_FETCH_RETRIES=2
BLESSING_TOKEN_RETRIES=0
BLESSING_USER_AGENT=XDUCraft-Survey/0.1
BLESSING_FETCH_PLAYERS=false
# Optional HTTP proxy for server-side OAuth token/user requests.
# Useful when the browser can reach the skin site through a proxy, but the local Node API cannot.
# In WSL, 127.0.0.1 may point to WSL itself rather than the Windows proxy process.
BLESSING_PROXY_URL=
BLESSING_DEBUG_PROFILE=false

# Comma-separated skin-site user ids, emails, nicknames, or game ids allowed to become admin.
BLESSING_ADMIN_IDS=

# Frontend API base.
# Leave empty when using npm run dev or the Vercel /api proxy.
# Set this only when the browser should call a separate API origin directly.
VITE_API_BASE_URL=
