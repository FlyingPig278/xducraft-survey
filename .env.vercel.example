# Vercel frontend + /api proxy
#
# Frontend domain:
# https://vote.example.com
#
# Recommended backend upstream:
# https://vote-api.example.com:8443

# Keep empty. The browser should call same-origin /api on the frontend domain.
VITE_API_BASE_URL=

# Real home API address reachable by Vercel Functions.
# Use HTTPS on 8443 if possible, because OAuth code/session traffic passes through this hop.
XDUCRAFT_UPSTREAM_API=https://vote-api.example.com:8443

# Same value as the home API. Generate a long random string before production.
XDUCRAFT_PROXY_SECRET=replace-with-a-long-random-string

# Optional. Leave unset unless the home API is slow across the network.
XDUCRAFT_PROXY_TIMEOUT_MS=15000
