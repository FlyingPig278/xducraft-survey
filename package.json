{
  "name": "xducraft-survey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "api": "node server/index.mjs",
    "dev": "node server/dev.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node server/index.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "naive-ui": "^2.44.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
